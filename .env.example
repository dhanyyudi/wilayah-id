# =============================================================
# wilayah-id — Environment Variables Template
# Copy this file to .env.local and fill in your values
# JANGAN commit .env.local ke repository!
# =============================================================

# ── Database ──────────────────────────────────────────────────
# Neon PostgreSQL (production)
DATABASE_URL=postgresql://username:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Self-hosted PostgreSQL (local)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wilayah_id

# ── Public service origins ────────────────────────────────────
# Server-side origin used by src/middleware.ts for /api/* requests
WILAYAH_API_ORIGIN=https://wilayah-id-api.dhanypedia.com

# Server-side origin used by src/middleware.ts for anonymous /tiles/* requests
WILAYAH_TILES_ORIGIN=https://tiles.dhanypedia.com

# Canonical public site URL used for metadata and absolute public links
NEXT_PUBLIC_SITE_URL=https://wilayah-id-web.gislabs.workers.dev

# ── API keys and rate limiting (origin role only) ────────────
# Enforcement is off unless this is "true".
# WILAYAH_RATE_LIMIT_ENABLED=true
# HMAC secret used to issue and verify free API keys (>= 32 characters)
# WILAYAH_KEY_SIGNING_SECRET=
# SHA-256 hashes of owner keys that skip the public limits
# WILAYAH_OWNER_KEYS_SHA256=
# Shared with the proxy deployment so the origin sees the visitor address
# WILAYAH_PROXY_TOKEN=
# Limits per minute unless noted; these are the defaults
# WILAYAH_LIMIT_ANON_PER_MINUTE=60
# WILAYAH_LIMIT_ANON_HEAVY_PER_MINUTE=10
# WILAYAH_LIMIT_KEY_PER_MINUTE=300
# WILAYAH_LIMIT_KEY_HEAVY_PER_MINUTE=60
# WILAYAH_LIMIT_KEY_PER_DAY=20000
# WILAYAH_LIMIT_OWNER_PER_MINUTE=3000
# WILAYAH_LIMIT_KEY_ISSUE_PER_DAY=5
# WILAYAH_KEY_TTL_DAYS=365

# ── Tiles ─────────────────────────────────────────────────────
# Base URL untuk vector tiles (default: /tiles = served dari public/tiles/)
NEXT_PUBLIC_TILES_BASE_URL=/tiles

# ── Neon API (untuk MCP tools, opsional) ─────────────────────
# NEON_API_KEY=your_neon_api_key_here

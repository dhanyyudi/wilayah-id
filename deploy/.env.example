# Store the raw API key only in a password manager and the client environment.
# This deployment file accepts SHA-256 hashes, never raw API keys.
WILAYAH_RUNTIME_ROLE=origin
MCP_API_KEYS_SHA256=<64-character-sha256-hex>
MCP_PUBLIC_BASE_URL=https://wilayah-id-mcp-staging.dhanypedia.com

# API keys and rate limiting. Generate both secrets with `openssl rand -hex 32`.
# The signing secret is shared by the API and MCP services; anyone who has it
# can mint free-tier keys, so rotate it if it leaks (all issued keys stop
# working). The proxy token must equal the WILAYAH_PROXY_TOKEN Worker secret.
WILAYAH_RATE_LIMIT_ENABLED=true
WILAYAH_KEY_SIGNING_SECRET=<at-least-32-characters>
WILAYAH_PROXY_TOKEN=<at-least-32-characters>
# Owner keys skip the public limits. Hashes only, comma-separated, one per app.
WILAYAH_OWNER_KEYS_SHA256=<64-character-sha256-hex>
# Optional: only accept owner keys from these addresses.
WILAYAH_OWNER_ALLOWED_IPS=
# Optional: comma-separated ids of issued keys to refuse.
WILAYAH_REVOKED_KEY_IDS=
